# Copy to .env IN THIS DIRECTORY. The root .env is not used.
# Use a long random hexadecimal password (no URI escaping is needed).
POSTGRES_PASSWORD=

# Needed for chat and indexing documents. The web and Northwind start without it.
OPENAI_API_KEY=

IATOOLKIT_PORT=8080
IATOOLKIT_BIND_ADDRESS=127.0.0.1
# Set true when serving through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
